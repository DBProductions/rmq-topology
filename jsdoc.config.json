{
  "plugins": ["plugins/markdown"],
  "source": {
    "include": ["src", "src/utils", "src/messages"],
    "exclude": [],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "opts": {
    "template": "node_modules/clean-jsdoc-theme/dist",
    "encoding": "utf8",
    "destination": "./public/doc/",
    "theme_opts": {
      "default_theme": "light",
      "title": "rmq-topology",
      "homepageTitle": "JSDoc"
    }
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false,
    "default": {
      "includeDate": false,
      "useLongnameInNav": true,
      "outputSourceFiles": true
    }
  }
}
